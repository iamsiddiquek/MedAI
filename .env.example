# Copy to .env and fill in, or run infra/scripts/init-env.sh to generate random values.
# Names and safe placeholders only. Never commit a real .env.

AFIA_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
AFIA_S3_ACCESS_KEY=change-me
AFIA_S3_SECRET_KEY=change-me-at-least-8-chars
AFIA_AMBIENT_CLIENT_SECRET=change-me
LITELLM_MASTER_KEY=sk-change-me
# Password of the synthetic demo users (dr.sara, dr.omar, auditor.demo). Local development only.
AFIA_DEV_USER_PASSWORD=change-me

# Local models. Smaller models are faster on a laptop and less accurate, above all for Arabic.
# If you change these, change the matching version in services/model-gateway/model_gateway/registry.local.yaml.
AFIA_WHISPER_MODEL=Systran/faster-whisper-large-v3
AFIA_OLLAMA_MODEL=qwen2.5:7b
